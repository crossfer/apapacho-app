# -----------------------------------------------------------------------------
# Apapacho Homes — environment variables
# Copy to .env.local and fill in the values (do NOT commit .env.local).
# -----------------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email (client welcome, service completed)
RESEND_API_KEY=

# Public app URL (used for auth redirects, email links)
NEXT_PUBLIC_APP_URL=https://app.apapachohomes.com
